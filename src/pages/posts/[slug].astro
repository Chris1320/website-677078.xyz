---
import Layout from '../../layouts/Layout.astro';
import AsciiTitle from '../../components/AsciiTitle.astro';
import { Icon } from 'astro-icon/components';
import { eq } from 'drizzle-orm';
import { getDb, posts, tags, post_tags } from '../../db';
import { renderMarkdown, calculateReadingTime } from '../../lib/markdown';
import { getAuthenticatedUser } from '../../lib/auth';
import { formatDate } from '../../lib/utils';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

let post: any = null;
let postTags: { id: string; name: string; slug: string }[] = [];
let renderedHtml = '';

try {
  const db = getDb();

  const foundPost = await db
    .select()
    .from(posts)
    .where(eq(posts.slug, slug))
    .get();

  if (!foundPost) {
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }

  // Guard draft posts
  if (foundPost.status === 'draft') {
    const authUser = await getAuthenticatedUser(Astro.request);
    if (!authUser) {
      Astro.response.status = 404;
      return Astro.rewrite('/404');
    }
    return Astro.redirect(`/admin?edit=${foundPost.id}`);
  }

  // Edge Cache Control for Public Published Post
  Astro.response.headers.set(
    'Cache-Control',
    'public, max-age=0, s-maxage=86400, stale-while-revalidate=3600'
  );

  post = foundPost;

  // Query tags
  const tagRows = await db
    .select({
      id: tags.id,
      name: tags.name,
      slug: tags.slug,
    })
    .from(post_tags)
    .innerJoin(tags, eq(post_tags.tag_id, tags.id))
    .where(eq(post_tags.post_id, post.id))
    .all();

  postTags = tagRows;

  // Render Markdown
  renderedHtml = post.content_html || (await renderMarkdown(post.content));
} catch (error) {
  console.error('Error fetching blog post:', error);
  return new Response(null, { status: 500, statusText: 'Internal Server Error' });
}

const readTime = calculateReadingTime(post.content);
---

<Layout
  title={`${post.title} | CFN`}
  description={post.description || post.title}
>
  <div class="content space-y-8">
    <AsciiTitle />

    <div class="flex items-center justify-between text-xs font-mono text-(--text-muted) border-b border-(--border-main) pb-3">
      <a
        href="/posts"
        class="text-(--accent-green) hover:text-(--accent-green-bright) inline-flex items-center gap-1.5"
      >
        <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
        <span>Back to all posts</span>
      </a>
      <span>// 677078.XYZ/POSTS</span>
    </div>
    <header class="space-y-4 border-b border-(--border-main) pb-6">
      <div class="flex flex-wrap items-center gap-3 text-xs text-(--text-secondary) font-mono">
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
          <span>{formatDate(post.published_at || post.created_at)}</span>
        </span>
        <span>•</span>
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:clock" class="w-3.5 h-3.5" />
          <span>{readTime} min read</span>
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) leading-tight tracking-tight">
        {post.title}
      </h1>
      {post.description && (
        <p class="text-sm text-(--text-secondary) leading-relaxed italic border-l-2 border-(--accent-green) pl-3">
          {post.description}
        </p>
      )}
      {postTags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {postTags.map((tag) => (
            <a
              href={`/posts?tag=${tag.slug}`}
              class="px-2 py-0.5 text-xs font-mono bg-(--bg-surface-elevated) border border-(--border-subtle) text-(--text-secondary) hover:text-(--accent-green-bright) hover:border-(--accent-green) transition-colors inline-flex items-center gap-1"
            >
              #{tag.name}
            </a>
          ))}
        </div>
      )}
    </header>
    <main
      class="article-body markdown-body max-w-none text-sm sm:text-base leading-relaxed text-(--text-primary)"
      set:html={renderedHtml}
    />
    <footer class="pt-8 border-t border-(--border-main) flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-(--text-muted)">
      <div>
        <button
          type="button"
          id="copy-link-btn"
          aria-label="Copy link to article"
          class="px-4 py-2 border border-(--border-main) text-(--text-primary) hover:border-(--border-highlight) hover:bg-(--accent-green-glow) transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          <Icon name="lucide:copy" class="w-3.5 h-3.5" />
          <span id="copy-link-text">Copy Link</span>
        </button>
      </div>
      <div>
        <a
          href="/posts"
          class="px-4 py-2 border border-(--border-main) text-(--text-primary) hover:border-(--border-highlight) hover:bg-(--accent-green-glow) transition-colors inline-flex items-center gap-1.5"
        >
          <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
          <span>View More Posts</span>
        </a>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-link-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyText.textContent;
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }
</script>
