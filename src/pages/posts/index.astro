---
import Layout from '../../layouts/Layout.astro';
import AsciiTitle from '../../components/AsciiTitle.astro';
import { Icon } from 'astro-icon/components';
import { desc, asc, eq, inArray } from 'drizzle-orm';
import { getDb, posts, tags, post_tags } from '../../db';
import { calculateReadingTime } from '../../lib/markdown';

export const prerender = false;

// Edge Cache Control for Public Blog List
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400'
);

const searchParam = Astro.url.searchParams.get('search')?.trim() || '';
const tagParam = Astro.url.searchParams.get('tag')?.trim() || '';
const sortParam = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'latest';
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const PAGE_SIZE = 10;

let allTags: { id: string; name: string; slug: string; count: number }[] = [];
let filteredPosts: any[] = [];
let totalFilteredCount = 0;
let totalPages = 1;

try {
  const db = getDb();

  // 1. Fetch all published posts ordered
  const sortOrder = sortParam === 'oldest' ? asc(posts.published_at) : desc(posts.published_at);

  const allPublishedPosts = await db
    .select({
      id: posts.id,
      slug: posts.slug,
      title: posts.title,
      description: posts.description,
      content: posts.content,
      published_at: posts.published_at,
      created_at: posts.created_at,
    })
    .from(posts)
    .where(eq(posts.status, 'published'))
    .orderBy(sortOrder)
    .all();

  // 2. Fetch all tag associations for published posts
  const allPostTags = await db
    .select({
      post_id: post_tags.post_id,
      tag_id: tags.id,
      tag_name: tags.name,
      tag_slug: tags.slug,
    })
    .from(post_tags)
    .innerJoin(tags, eq(post_tags.tag_id, tags.id))
    .all();

  // Group tags by post_id
  const tagsByPostId: Record<string, { id: string; name: string; slug: string }[]> = {};
  const tagCountMap: Record<string, { id: string; name: string; slug: string; count: number }> = {};

  for (const pt of allPostTags) {
    if (!tagsByPostId[pt.post_id]) {
      tagsByPostId[pt.post_id] = [];
    }
    tagsByPostId[pt.post_id].push({
      id: pt.tag_id,
      name: pt.tag_name,
      slug: pt.tag_slug,
    });

    if (!tagCountMap[pt.tag_slug]) {
      tagCountMap[pt.tag_slug] = {
        id: pt.tag_id,
        name: pt.tag_name,
        slug: pt.tag_slug,
        count: 0,
      };
    }
    tagCountMap[pt.tag_slug].count += 1;
  }

  allTags = Object.values(tagCountMap).sort((a, b) => b.count - a.count);

  // 3. Attach tags & reading time to posts
  const postsWithMetadata = allPublishedPosts.map((p) => ({
    ...p,
    tags: tagsByPostId[p.id] || [],
    readTime: calculateReadingTime(p.content),
  }));

  // 4. In-memory filter for search and tag
  let matched = postsWithMetadata;

  if (tagParam) {
    matched = matched.filter((p) =>
      p.tags.some((t) => t.slug === tagParam || t.name.toLowerCase() === tagParam.toLowerCase())
    );
  }

  if (searchParam) {
    const q = searchParam.toLowerCase();
    matched = matched.filter(
      (p) =>
        p.title.toLowerCase().includes(q) ||
        p.slug.toLowerCase().includes(q) ||
        (p.description && p.description.toLowerCase().includes(q)) ||
        p.content.toLowerCase().includes(q) ||
        p.tags.some((t) => t.name.toLowerCase().includes(q))
    );
  }

  totalFilteredCount = matched.length;
  totalPages = Math.max(1, Math.ceil(totalFilteredCount / PAGE_SIZE));

  // 5. Paginate items (10 posts per page)
  const offset = (currentPage - 1) * PAGE_SIZE;
  filteredPosts = matched.slice(offset, offset + PAGE_SIZE);
} catch (error) {
  console.error('Error loading posts list:', error);
}

function formatDate(timestamp: number | Date | null | undefined) {
  if (!timestamp) return '';
  const date = typeof timestamp === 'number' ? new Date(timestamp) : timestamp;
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function getPageUrl(targetPage: number) {
  const params = new URLSearchParams();
  if (targetPage > 1) params.set('page', targetPage.toString());
  if (searchParam) params.set('search', searchParam);
  if (tagParam) params.set('tag', tagParam);
  if (sortParam !== 'latest') params.set('sort', sortParam);
  const qs = params.toString();
  return qs ? `/posts?${qs}` : '/posts';
}
---

<Layout
  title="Posts | CFN"
  description="Technical articles, security research, and systems engineering."
>
  <div class="content space-y-8">
    <AsciiTitle />

    <!-- Filter & Search Toolbar -->
    <div class="border border-[var(--border-main)] bg-[var(--bg-surface)] p-4 space-y-4">
      <form method="GET" action="/posts" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="flex-1 relative">
          <Icon name="lucide:search" class="w-4 h-4 text-[var(--text-muted)] absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            name="search"
            value={searchParam}
            placeholder="Search articles by title or keyword..."
            class="w-full pl-9 pr-3 py-2 text-sm bg-[var(--bg-primary)] border border-[var(--border-main)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--border-highlight)] font-mono"
          />
        </div>

        {tagParam && <input type="hidden" name="tag" value={tagParam} />}

        <div class="flex items-center gap-2">
          <select
            name="sort"
            onchange="this.form.submit()"
            class="px-3 py-2 text-xs uppercase tracking-wider bg-[var(--bg-primary)] border border-[var(--border-main)] text-[var(--text-secondary)] focus:outline-none focus:border-[var(--border-highlight)] font-mono cursor-pointer"
          >
            <option value="latest" selected={sortParam === 'latest'}>Sort: Latest</option>
            <option value="oldest" selected={sortParam === 'oldest'}>Sort: Oldest</option>
          </select>

          <button
            type="submit"
            class="px-4 py-2 text-xs uppercase tracking-wider font-bold bg-[var(--accent-green)] text-[var(--text-inverse)] hover:bg-[var(--accent-green-bright)] transition-colors inline-flex items-center gap-1.5"
          >
            <Icon name="lucide:search" class="w-3.5 h-3.5" />
            <span>Search</span>
          </button>

          {(searchParam || tagParam || sortParam !== 'latest') && (
            <a
              href="/posts"
              class="px-3 py-2 text-xs uppercase tracking-wider border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-main)]"
            >
              Reset
            </a>
          )}
        </div>
      </form>

      <!-- Tag Filters -->
      {allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-[var(--border-subtle)]">
          <span class="text-xs text-[var(--text-muted)] uppercase tracking-wider mr-2 inline-flex items-center gap-1">
            <Icon name="lucide:tag" class="w-3.5 h-3.5" />
            <span>Tags:</span>
          </span>
          <a
            href={searchParam ? `/posts?search=${encodeURIComponent(searchParam)}` : '/posts'}
            class:list={[
              'px-2 py-0.5 text-xs font-mono transition-colors border',
              !tagParam
                ? 'border-[var(--accent-green)] bg-[var(--accent-green-glow)] text-[var(--accent-green-bright)] font-bold'
                : 'border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-main)]',
            ]}
          >
            All
          </a>
          {allTags.map((tag) => (
            <a
              href={`/posts?tag=${tag.slug}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}${sortParam !== 'latest' ? `&sort=${sortParam}` : ''}`}
              class:list={[
                'px-2 py-0.5 text-xs font-mono transition-colors border inline-flex items-center gap-1',
                tagParam === tag.slug
                  ? 'border-[var(--accent-green)] bg-[var(--accent-green-glow)] text-[var(--accent-green-bright)] font-bold'
                  : 'border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-main)]',
              ]}
            >
              #{tag.name} <span class="text-[var(--text-muted)] text-[10px]">({tag.count})</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Blog Posts List -->
    <div class="space-y-4">
      {filteredPosts.length === 0 ? (
        <div class="border border-[var(--border-main)] bg-[var(--bg-surface)] p-12 text-center space-y-2">
          <div class="text-[var(--accent-green)] text-sm font-mono font-bold">
            > NO_POSTS_FOUND
          </div>
          <p class="text-xs text-[var(--text-secondary)]">
            {searchParam || tagParam
              ? 'No articles match the selected search or tag filter.'
              : 'No articles have been published yet. Check back soon!'}
          </p>
          {(searchParam || tagParam) && (
            <div class="pt-4">
              <a
                href="/posts"
                class="px-4 py-1.5 text-xs uppercase tracking-wider font-bold border border-[var(--border-main)] text-[var(--text-primary)] hover:border-[var(--border-highlight)] inline-flex items-center gap-1.5"
              >
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>View All Posts</span>
              </a>
            </div>
          )}
        </div>
      ) : (
        <div class="divide-y divide-[var(--border-main)] border border-[var(--border-main)] bg-[var(--bg-surface)]">
          {filteredPosts.map((post) => (
            <article class="p-6 hover:bg-[var(--bg-surface-hover)] transition-colors group">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-[var(--text-muted)] mb-2 font-mono">
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-1">
                    <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                    <span>{formatDate(post.published_at || post.created_at)}</span>
                  </span>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1">
                    <Icon name="lucide:clock" class="w-3.5 h-3.5" />
                    <span>{post.readTime} min read</span>
                  </span>
                </div>
                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.tags.map((tag: any) => (
                      <a
                        href={`/posts?tag=${tag.slug}`}
                        class="px-1.5 py-0.5 text-[11px] bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--accent-green-bright)] hover:border-[var(--accent-green)] transition-colors inline-flex items-center gap-1"
                      >
                        #{tag.name}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              <h2 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-green-bright)] transition-colors mb-2">
                <a href={`/posts/${post.slug}`} class="block">
                  {post.title}
                </a>
              </h2>

              {post.description && (
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
                  {post.description}
                </p>
              )}

              <div>
                <a
                  href={`/posts/${post.slug}`}
                  class="text-xs font-mono text-[var(--accent-green)] hover:text-[var(--accent-green-bright)] inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
                >
                  <span>Read Article</span>
                  <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      )}

      <!-- Pagination Bar -->
      {totalPages > 1 && (
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border border-[var(--border-main)] bg-[var(--bg-surface)] p-4 font-mono text-xs">
          <div class="text-[var(--text-muted)]">
            Showing <strong class="text-[var(--text-primary)]">{filteredPosts.length}</strong> of{' '}
            <strong class="text-[var(--text-primary)]">{totalFilteredCount}</strong> posts (Page {currentPage} of {totalPages})
          </div>

          <div class="flex items-center gap-2">
            {currentPage > 1 ? (
              <a
                href={getPageUrl(currentPage - 1)}
                class="px-3 py-1.5 border border-[var(--border-main)] text-[var(--text-primary)] hover:border-[var(--border-highlight)] hover:bg-[var(--accent-green-glow)] transition-colors inline-flex items-center gap-1"
              >
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>Prev</span>
              </a>
            ) : (
              <span class="px-3 py-1.5 border border-[var(--border-subtle)] text-[var(--text-muted)] opacity-50 cursor-not-allowed inline-flex items-center gap-1">
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>Prev</span>
              </span>
            )}

            <!-- Page Number Indicator -->
            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                <a
                  href={getPageUrl(p)}
                  class:list={[
                    'w-8 h-8 flex items-center justify-center text-xs border transition-colors',
                    p === currentPage
                      ? 'border-[var(--accent-green)] bg-[var(--accent-green-glow)] text-[var(--accent-green-bright)] font-bold'
                      : 'border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-main)] hover:text-[var(--text-primary)]',
                  ]}
                >
                  {p}
                </a>
              ))}
            </div>

            {currentPage < totalPages ? (
              <a
                href={getPageUrl(currentPage + 1)}
                class="px-3 py-1.5 border border-[var(--border-main)] text-[var(--text-primary)] hover:border-[var(--border-highlight)] hover:bg-[var(--accent-green-glow)] transition-colors inline-flex items-center gap-1"
              >
                <span>Next</span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </a>
            ) : (
              <span class="px-3 py-1.5 border border-[var(--border-subtle)] text-[var(--text-muted)] opacity-50 cursor-not-allowed inline-flex items-center gap-1">
                <span>Next</span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </span>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
