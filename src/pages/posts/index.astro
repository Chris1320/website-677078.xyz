---
import Layout from '../../layouts/Layout.astro';
import AsciiTitle from '../../components/AsciiTitle.astro';
import { Icon } from 'astro-icon/components';
import { desc, asc, eq, and, or, like, sql, count, inArray } from 'drizzle-orm';
import { getDb, posts, tags, post_tags } from '../../db';
import { calculateReadingTime } from '../../lib/markdown';
import { formatDate, getPaginationWindow } from '../../lib/utils';
import { POSTS_PAGE_SIZE } from '../../lib/info';

export const prerender = false;

// Edge Cache Control for Public Blog Index
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400'
);

const searchParam = Astro.url.searchParams.get('search')?.trim() || '';
const tagParam = Astro.url.searchParams.get('tag')?.trim() || '';
const sortParam = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'latest';
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;

let allTags: { id: string; name: string; slug: string; count: number }[] = [];
let filteredPosts: any[] = [];
let totalFilteredCount = 0;
let totalPages = 1;

try {
  const db = getDb();

  const tagRows = await db
    .select({
      id: tags.id,
      name: tags.name,
      slug: tags.slug,
      count: count(),
    })
    .from(post_tags)
    .innerJoin(tags, eq(post_tags.tag_id, tags.id))
    .innerJoin(posts, eq(post_tags.post_id, posts.id))
    .where(eq(posts.status, 'published'))
    .groupBy(tags.id, tags.name, tags.slug)
    .orderBy(desc(count()))
    .all();

  allTags = tagRows.map((r) => ({ id: r.id, name: r.name, slug: r.slug, count: r.count }));
  const conditions = [eq(posts.status, 'published')];
  if (tagParam) {
    conditions.push(
      sql`${posts.id} IN (SELECT ${post_tags.post_id} FROM ${post_tags} INNER JOIN ${tags} ON ${post_tags.tag_id} = ${tags.id} WHERE ${tags.slug} = ${tagParam})`
    );
  }

  if (searchParam) {
    const pattern = `%${searchParam}%`;
    conditions.push(
      or(
        like(posts.title, pattern),
        like(posts.slug, pattern),
        like(posts.description, pattern),
        like(posts.content, pattern),
        sql`${posts.id} IN (SELECT ${post_tags.post_id} FROM ${post_tags} INNER JOIN ${tags} ON ${post_tags.tag_id} = ${tags.id} WHERE ${tags.name} LIKE ${pattern})`
      )!
    );
  }

  const whereClause = and(...conditions);
  const [{ total }] = await db
    .select({ total: count() })
    .from(posts)
    .where(whereClause)
    .all();

  totalFilteredCount = total;
  totalPages = Math.max(1, Math.ceil(totalFilteredCount / POSTS_PAGE_SIZE));

  const sortOrder = sortParam === 'oldest' ? asc(posts.published_at) : desc(posts.published_at);
  const pageOffset = (currentPage - 1) * POSTS_PAGE_SIZE;

  const paginatedRows = await db
    .select({
      id: posts.id,
      slug: posts.slug,
      title: posts.title,
      description: posts.description,
      content: posts.content,
      published_at: posts.published_at,
      created_at: posts.created_at,
    })
    .from(posts)
    .where(whereClause)
    .orderBy(sortOrder)
    .limit(POSTS_PAGE_SIZE)
    .offset(pageOffset)
    .all();

  const postIds = paginatedRows.map((p) => p.id);
  const tagsByPostId: Record<string, { id: string; name: string; slug: string }[]> = {};
  if (postIds.length > 0) {
    const postTagRows = await db
      .select({
        post_id: post_tags.post_id,
        tag_id: tags.id,
        tag_name: tags.name,
        tag_slug: tags.slug,
      })
      .from(post_tags)
      .innerJoin(tags, eq(post_tags.tag_id, tags.id))
      .where(inArray(post_tags.post_id, postIds))
      .all();

    for (const pt of postTagRows) {
      if (!tagsByPostId[pt.post_id]) tagsByPostId[pt.post_id] = [];
      tagsByPostId[pt.post_id].push({ id: pt.tag_id, name: pt.tag_name, slug: pt.tag_slug });
    }
  }

  filteredPosts = paginatedRows.map((p) => ({
    ...p,
    tags: tagsByPostId[p.id] || [],
    readTime: calculateReadingTime(p.content),
  }));
} catch (error) {
  console.error('Error loading posts list:', error);
}

function getPageUrl(targetPage: number) {
  const params = new URLSearchParams();
  if (targetPage > 1) params.set('page', targetPage.toString());
  if (searchParam) params.set('search', searchParam);
  if (tagParam) params.set('tag', tagParam);
  if (sortParam !== 'latest') params.set('sort', sortParam);
  const qs = params.toString();
  return qs ? `/posts?${qs}` : '/posts';
}
---

<Layout
  title="Posts | CFN"
  description="Blog Posts"
>
  <div class="content space-y-8">
    <AsciiTitle />

    <div class="border border-(--border-main) bg-(--bg-surface) p-4 space-y-4">
      <form method="GET" action="/posts" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="flex-1 relative">
          <Icon name="lucide:search" class="w-4 h-4 text-(--text-muted) absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            name="search"
            value={searchParam}
            placeholder="Search articles by title or keyword..."
            class="w-full pl-9 pr-3 py-2 text-sm bg-(--bg-primary) border border-(--border-main) text-(--text-primary) placeholder-(--text-muted) focus:outline-none focus:border-(--border-highlight) font-mono"
          />
        </div>
        {tagParam && <input type="hidden" name="tag" value={tagParam} />}
        <div class="flex items-center gap-2">
          <!-- TODO: stylize dropdown -->
          <select
            name="sort"
            onchange="this.form.submit()"
            class="px-3 py-2 text-xs uppercase tracking-wider bg-(--bg-primary) border border-(--border-main) text-(--text-secondary) focus:outline-none focus:border-(--border-highlight) font-mono cursor-pointer"
          >
            <option value="latest" selected={sortParam === 'latest'}>Sort: Latest</option>
            <option value="oldest" selected={sortParam === 'oldest'}>Sort: Oldest</option>
          </select>
          <button
            type="submit"
            class="px-4 py-2 text-xs uppercase tracking-wider font-bold bg-(--accent-green) text-(--text-inverse) hover:bg-(--accent-green-bright) transition-colors inline-flex items-center gap-1.5"
          >
            <Icon name="lucide:search" class="w-3.5 h-3.5" />
            <span>Search</span>
          </button>
          {(searchParam || tagParam || sortParam !== 'latest') && (
            <a
              href="/posts"
              class="px-3 py-2 text-xs uppercase tracking-wider border border-(--border-subtle) text-(--text-muted) hover:text-(--text-primary) hover:border-(--border-main)"
            >
              Reset
            </a>
          )}
        </div>
      </form>
      {allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-(--border-subtle)">
          <span class="text-xs text-(--text-muted) uppercase tracking-wider mr-2 inline-flex items-center gap-1">
            <Icon name="lucide:tag" class="w-3.5 h-3.5" />
            <span>Tags:</span>
          </span>
          <a
            href={searchParam ? `/posts?search=${encodeURIComponent(searchParam)}` : '/posts'}
            class:list={[
              'px-2 py-0.5 text-xs font-mono transition-colors border',
              !tagParam
                ? 'border-(--accent-green) bg-(--accent-green-glow) text-(--accent-green-bright) font-bold'
                : 'border-(--border-subtle) text-(--text-secondary) hover:text-(--text-primary) hover:border-(--border-main)',
            ]}
          >
            All
          </a>
          {allTags.map((tag) => (
            <a
              href={`/posts?tag=${tag.slug}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}${sortParam !== 'latest' ? `&sort=${sortParam}` : ''}`}
              class:list={[
                'px-2 py-0.5 text-xs font-mono transition-colors border inline-flex items-center gap-1',
                tagParam === tag.slug
                  ? 'border-(--accent-green) bg-(--accent-green-glow) text-(--accent-green-bright) font-bold'
                  : 'border-(--border-subtle) text-(--text-secondary) hover:text-(--text-primary) hover:border-(--border-main)',
              ]}
            >
              #{tag.name} <span class="text-(--text-muted) text-[10px]">({tag.count})</span>
            </a>
          ))}
        </div>
      )}
    </div>
    <div class="space-y-4">
      {filteredPosts.length === 0 ? (
        <div class="border border-(--border-main) bg-(--bg-surface) p-12 text-center space-y-2">
          <div class="text-(--accent-green) text-sm font-mono font-bold">
            > NO_POSTS_FOUND
          </div>
          <p class="text-xs text-(--text-secondary)">
            {searchParam || tagParam
              ? 'No articles match the selected search or tag filter.'
              : 'No articles have been published yet. Check back soon!'}
          </p>
          {(searchParam || tagParam) && (
            <div class="pt-4">
              <a
                href="/posts"
                class="px-4 py-1.5 text-xs uppercase tracking-wider font-bold border border-(--border-main) text-(--text-primary) hover:border-(--border-highlight) inline-flex items-center gap-1.5"
              >
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>View All Posts</span>
              </a>
            </div>
          )}
        </div>
      ) : (
        <div class="divide-y divide-(--border-main) border border-(--border-main) bg-(--bg-surface)">
          {filteredPosts.map((post) => (
            <article class="p-6 hover:bg-(--bg-surface-hover) transition-colors group">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-(--text-muted) mb-2 font-mono">
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-1">
                    <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                    <span>{formatDate(post.published_at || post.created_at)}</span>
                  </span>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1">
                    <Icon name="lucide:clock" class="w-3.5 h-3.5" />
                    <span>{post.readTime} min read</span>
                  </span>
                </div>
                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.tags.map((tag: any) => (
                      <a
                        href={`/posts?tag=${tag.slug}`}
                        class="px-1.5 py-0.5 text-[11px] bg-(--bg-surface-elevated) border border-(--border-subtle) text-(--text-secondary) hover:text-(--accent-green-bright) hover:border-(--accent-green) transition-colors inline-flex items-center gap-1"
                      >
                        #{tag.name}
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <h2 class="text-lg font-bold text-(--text-primary) group-hover:text-(--accent-green-bright) transition-colors mb-2">
                <a href={`/posts/${post.slug}`} class="block">
                  {post.title}
                </a>
              </h2>
              {post.description && (
                <p class="text-xs text-(--text-secondary) leading-relaxed mb-4 line-clamp-2">
                  {post.description}
                </p>
              )}
              <div>
                <a
                  href={`/posts/${post.slug}`}
                  class="text-xs font-mono text-(--accent-green) hover:text-(--accent-green-bright) inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
                >
                  <span>Read Article</span>
                  <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 border border-(--border-main) bg-(--bg-surface) p-4 font-mono text-xs">
          <div class="text-(--text-muted) whitespace-nowrap">
            Showing <strong class="text-(--text-primary)">{filteredPosts.length}</strong> of{' '}
            <strong class="text-(--text-primary)">{totalFilteredCount}</strong> posts (Page {currentPage} of {totalPages})
          </div>
          <div class="flex flex-wrap items-center justify-center gap-1.5 max-w-full">
            {currentPage > 1 ? (
              <a
                href={getPageUrl(currentPage - 1)}
                class="px-2.5 py-1 border border-(--border-main) text-(--text-primary) hover:border-(--border-highlight) hover:bg-(--accent-green-glow) transition-colors inline-flex items-center gap-1 text-xs"
              >
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>Prev</span>
              </a>
            ) : (
              <span class="px-2.5 py-1 border border-(--border-subtle) text-(--text-muted) opacity-50 cursor-not-allowed inline-flex items-center gap-1 text-xs">
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
                <span>Prev</span>
              </span>
            )}
            <div class="flex flex-wrap items-center gap-1">
              {getPaginationWindow(currentPage, totalPages).map((p) =>
                p === '...' ? (
                  <span class="w-7 h-7 flex items-center justify-center text-xs text-(--text-muted) select-none">
                    ...
                  </span>
                ) : (
                  <a
                    href={getPageUrl(Number(p))}
                    class:list={[
                      'w-7 h-7 flex items-center justify-center text-xs border transition-colors',
                      p === currentPage
                        ? 'border-(--accent-green) bg-(--accent-green-glow) text-(--accent-green-bright) font-bold'
                        : 'border-(--border-subtle) text-(--text-secondary) hover:border-(--border-main) hover:text-(--text-primary)',
                    ]}
                  >
                    {p}
                  </a>
                )
              )}
            </div>
            {currentPage < totalPages ? (
              <a
                href={getPageUrl(currentPage + 1)}
                class="px-2.5 py-1 border border-(--border-main) text-(--text-primary) hover:border-(--border-highlight) hover:bg-(--accent-green-glow) transition-colors inline-flex items-center gap-1 text-xs"
              >
                <span>Next</span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </a>
            ) : (
              <span class="px-2.5 py-1 border border-(--border-subtle) text-(--text-muted) opacity-50 cursor-not-allowed inline-flex items-center gap-1 text-xs">
                <span>Next</span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </span>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
