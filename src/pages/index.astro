---
import Layout from '../layouts/Layout.astro';
import AsciiTitle from '../components/AsciiTitle.astro';
import NoticeSection from '../components/NoticeSection.astro';
---

<Layout
	title="CFN | 677078.xyz"
	description="CFN"
>
	<div class="hero-content">
		<AsciiTitle />
		<NoticeSection />
    </div>

	<!-- Bottom Footer -->
	<footer class="site-footer">
		<div class="footer-left">
            <span>&copy; {new Date().getFullYear()} CFN // 677078.XYZ</span>
		</div>
		<div class="footer-right">
            <span class="footer-tag">
                <!-- shameless plug lmao -->
                <a href="https://chrisfromnowhere.me/" target="_blank" rel="noopener noreferrer">chrisfromnowhere.me</a>
            </span>
		</div>
	</footer>
</Layout>

<style>
	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.site-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 1.25rem;
		background-color: var(--bg-surface);
		border: 1px solid var(--border-main);
		font-size: 0.75rem;
		color: var(--text-muted);
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.footer-tag {
		color: var(--accent-green-dim);
		letter-spacing: 0.05em;
	}
</style>
